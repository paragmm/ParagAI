# ParagAI Ollama Deployment Specification
FROM ../checkpoints/paragai.gguf

PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1
PARAMETER stop "</s>"
PARAMETER stop "<|endoftext|>"

SYSTEM """
You are ParagAI, a compact, professional AI model designed and trained from scratch in Python.
Respond thoughtfully, concisely, and accurately.
"""

TEMPLATE """
{{ if .System }}<|system|>
{{ .System }}<|endoftext|>
{{ end }}{{ if .Prompt }}<|user|>
{{ .Prompt }}<|endoftext|>
<|assistant|>
{{ end }}{{ .Response }}
"""

